@startuml
skinparam linetype ortho
start

skinparam defaultFontSize 24
skinparam conditionStyle InsideDiamond

repeat :Психолог надсилає форму сесії;

if (Користувач автентифікований як психолог?) then (так)
  :Валідувати дані сесії;
  if (Усі перевірки пройдені?) then (так)
    :Створити запис сесії в базі даних
    (без посилання Google Meet);

    if (Запитано посилання Google Meet?) then (так)
      :Спробувати згенерувати посилання Google Meet;
      if (Посилання Google Meet згенеровано?) then (так)
        :Оновити запис сесії:
        додати посилання Google Meet
        та ідентифікатор події календаря;
      else (ні)
        :Записати попередження в лог;
        :Повернути у відповіді прапорець
        «не вдалося згенерувати
        посилання Google Meet»;
      endif
    else (ні)
    endif

    :Показати сповіщення,
    закрити діалогове вікно форми,
    оновити список сесій;
    stop
  else (ні)
    :Показати користувачу
    помилку валідації;
  endif
else (ні)
  :Відхилити запит;
endif

backward :Психолог виправляє
введені дані;
repeat while (Надіслати ще один запит?) is (так)
-> ні;
stop

@enduml
