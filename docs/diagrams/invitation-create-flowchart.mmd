%% Блок-схема алгоритму створення запрошення (підрозділ 3.3.4), нотація ISO 5807.
%% Відображає InvitationsService.createForPsycho
%% (backend/src/features/invitations/services.ts).
%% Фігури: овал — початок/кінець; паралелограм — ввід/вивід; прямокутник — дія;
%% ромб — умова; прямокутник із подвійними лініями — виклик підпрограм.
%% Літеру додатка узгодити з фінальним порядком додатків.
flowchart TD
    S(["Початок"])
    I[/"Ввід: psychoId, email"/]
    P1["email = trim(lower(email));<br/>userId = пошук користувача за email"]
    D1{"userId == psychoId<br/>або userId уже клієнт?"}
    D2{"Є відкладене запрошення<br/>для psychoId та email?"}
    T[["Транзакція: зберегти запрошення;<br/>поставити лист у чергу"]]
    O1[/"Вивід: відмова"/]
    O2[/"Вивід: наявне запрошення"/]
    O3[/"Вивід: нове запрошення з посиланням"/]
    E(["Кінець"])

    S --> I --> P1 --> D1
    D1 -- Так --> O1 --> E
    D1 -- Ні --> D2
    D2 -- Так --> O2 --> E
    D2 -- Ні --> T --> O3 --> E
