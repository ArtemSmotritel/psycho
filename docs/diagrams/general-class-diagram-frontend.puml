@startuml
' Рисунок 2. Загальна діаграма класів: клієнтська частина та її звʼязки з сервером (підрозділ 3.3.5).
' Рівень деталізації: групи класів. Усередині блоку — імена класів.
' Сторінки названо за іменами файлів у frontend/app/routes (з назвою папки).
' Не показано: shadcn-компоненти, дрібні спільні компоненти, дрібні хуки.
' Стрілки показують лише звʼязки між групами. Повний перелік стрілок між класами:
' docs/diagrams/specs/general-class-diagram.md.
' Серверні домени (праворуч) відповідають блокам Рисунка 1.

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName "Times New Roman"
skinparam nodesep 50
skinparam ranksep 80
hide circle
hide methods

' ======== Сторінки ========
class "Спільні сторінки" as sharedPages <<сторінки>> {
    root
    home
    login
    auth-callback
    role-select
    invite
}

class "Сторінки психолога" as psychoPages <<сторінки>> {
    psychologist/layout
    psychologist/dashboard.index
    psychologist/clients
    psychologist/client-layout
    psychologist/client-profile
    psychologist/client-progress
    psychologist/client-sessions
    psychologist/session
    psychologist/session-attachment
    psychologist/live-session
    psychologist/invitations
    psychologist/associative-images
    psychologist/sessions
}

class "Сторінки клієнта" as clientPages <<сторінки>> {
    client/layout
    client/dashboard
    client/profile
    client/appointments
    client/appointment-detail
    client/live-appointment
    client/attachment-detail
    client/progress
}

' ======== Компоненти ========
class "Каркас застосунку" as shell <<компоненти>> {
    RoleLayout
    AppSidebar
    ProtectedRoute
    AuthContext
}

class "Сесії та клієнти" as forms <<компоненти>> {
    SessionForm
    PingConflictDialog
    PostSessionFollowUpDialog
    ClientForm
    AddClientByEmailDialog
}

class "Вкладення" as attachmentsUi <<компоненти>> {
    AttachmentForm
    AttachmentList
    AttachmentDetail
    AppointmentNotesPanel
    AppointmentRecommendationsPanel
    RecommendationReactionBlock
    PostSessionImpressionDialog
}

class "Асоціативні зображення" as imagesUi <<компоненти>> {
    AssociativeImagePicker
    AssociativeImageBrowser
    AddImageDialog
}

class "Інтерактивна дошка" as whiteboardUi <<компоненти>> {
    Excalidraw
    useWhiteboardSync
    WhiteboardCursorOverlay
    WhiteboardImageInsert
    WhiteboardSnapshot
}

' ======== API-сервіси ========
class "API-сервіси" as api <<сервіси>> {
    ApiClient
    AuthApiService
    UserApiService
    ClientApiService
    InvitationApiService
    AppointmentApiService
    AttachmentApiService
    RecommendationApiService
    ImpressionApiService
    FileApiService
    AssociativeImageApiService
    DashboardApiService
    ProgressApiService
}

' ======== Сервер: домени з Рисунка 1 ========
class "BetterAuth" as sBetter <<сервер>>
class "users" as sUsers <<сервер>> {
    UserRoutes
}
class "clients" as sClients <<сервер>> {
    ClientSelfRoutes
    ClientRoutes
}
class "invitations" as sInvitations <<сервер>> {
    InvitationRoutes
}
class "appointments" as sAppointments <<сервер>> {
    AppointmentRoutes
    PsychoAppointmentRoutes
    ClientAppointmentRoutes
}
class "attachments" as sAttachments <<сервер>> {
    PsychoAttachmentRoutes
    ClientAttachmentRoutes
}
class "progress" as sProgress <<сервер>> {
    PsychoProgressRoutes
    ClientProgressRoutes
}
class "files" as sFiles <<сервер>> {
    FileRoutes
}
class "associative-images" as sImages <<сервер>> {
    AssociativeImageRoutes
}
class "dashboard" as sDashboard <<сервер>> {
    PsychoDashboardRoutes
    ClientDashboardRoutes
}
class "whiteboard" as sWhiteboard <<сервер>> {
    WhiteboardRoutes
}

' ---- Сторінки -> інші групи ----
sharedPages ..> shell
sharedPages ..> api
psychoPages ..> shell
psychoPages ..> forms
psychoPages ..> attachmentsUi
psychoPages ..> imagesUi
psychoPages ..> whiteboardUi
psychoPages ..> api
clientPages ..> shell
clientPages ..> forms
clientPages ..> attachmentsUi
clientPages ..> whiteboardUi
clientPages ..> api

' ---- Компоненти -> компоненти та сервіси ----
attachmentsUi ..> imagesUi
whiteboardUi ..> imagesUi
shell ..> api
forms ..> api
attachmentsUi ..> api
imagesUi ..> api

' ---- API-сервіси -> сервер (HTTP) ----
api ..> sBetter : HTTP\nAuthApiService
api ..> sUsers : HTTP\nUserApiService
api ..> sClients : HTTP\nClientApiService
api ..> sInvitations : HTTP\nInvitationApiService
api ..> sAppointments : HTTP\nAppointmentApiService
api ..> sAttachments : HTTP\nAttachmentApiService,\nRecommendationApiService
api ..> sProgress : HTTP\nImpressionApiService,\nProgressApiService
api ..> sFiles : HTTP\nFileApiService
api ..> sImages : HTTP\nAssociativeImageApiService
api ..> sDashboard : HTTP\nDashboardApiService

' ---- Інтерактивна дошка -> сервер (WebSocket) ----
whiteboardUi ..> sWhiteboard : WebSocket\nuseWhiteboardSync

@enduml
