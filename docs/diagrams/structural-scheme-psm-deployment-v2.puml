@startuml
' Підрозділ 3.2 — Структурна схема реалізації (PSM), діаграма РОЗГОРТАННЯ.
' На відміну від діаграми компонентів (додаток Г, PIM), тут показано, ДЕ фізично
' виконується кожен артефакт і ЯК вузли обмінюються даними (протоколи на шляхах
' зв'язку). Внутрішню декомпозицію на 11 сервісів не дублюємо — вона належить
' діаграмі компонентів; сервер представлено одним артефактом розгортання,
' а перелік підсистем винесено в примітку.

skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam componentStyle uml2
skinparam wrapWidth 150
skinparam nodesep 18
skinparam ranksep 55
skinparam ArrowColor #444444

left to right direction

actor "Психолог" as psycho
actor "Клієнт" as clientActor

' ==== Клієнтський бік ====
node "Клієнтський пристрій" <<device>> as clientDevice {
    node "Веб-браузер" <<executionEnvironment>> as browserEnv {
        artifact "SPA-бандл\n(TypeScript, React 19, React Router v7,\nExcalidraw, Axios, Better Auth client)" as spa
        port "мережевий клієнт\n(Axios / WebSocket)" as clientPort
        clientPort - spa
    }
}

' ==== Хост застосунку (єдиний екземпляр) ====
node "Хост застосунку — один екземпляр" <<device>> as host {
    node "Bun Runtime" <<executionEnvironment>> as bunEnv {
        artifact "helpsycho-server\n(Hono: HTTP API + WebSocket-шлюз + Bun.cron)" as srv
        port "TCP :3000\n(HTTP + WS-upgrade)" as srvPort
        srv - srvPort
    }
    artifact "Локальне файлове сховище\n(завантажені двійкові файли)" <<local disk>> as disk
    bunEnv .> disk : «локальна ФС»
}


' ==== Сервер бази даних ====
node "Сервер БД" <<device>> as dbServer {
    node "PostgreSQL" <<executionEnvironment>> as pgEnv {
        artifact "Схема даних + міграції\n(користувачі, сесії, вкладення,\nзображення, файли, черга сповіщень)" as schema
    }
}

' ==== Зовнішні системи ====
cloud "Google Cloud" <<external>> as google {
    artifact "OAuth 2.0" as gOAuth
    artifact "Calendar API (+ Meet)\n(googleapis)" as gCal
}
node "Brevo" <<external>> as brevo {
    artifact "Transactional Email API" as brevoApi
}

' ==== Актори ====
psycho --> clientDevice
clientActor --> clientDevice

' ==== Шляхи зв'язку (вузол ↔ вузол, з протоколом) ====
clientPort -- srvPort : «HTTPS / REST»
clientPort -- srvPort : «WSS / WebSocket (HTTP upgrade)»

bunEnv -- pgEnv : «TCP» Bun SQL\n(доменні дані)
bunEnv -- pgEnv : «TCP» pg Pool\n(Better Auth)

bunEnv -- gOAuth : «HTTPS / OAuth 2.0»
bunEnv -- gCal   : «HTTPS / REST»
bunEnv -- brevoApi : «HTTPS / REST»

@enduml
