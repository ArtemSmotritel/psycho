@startuml
  start
  while (є ще вид нагадування для обробки?) is (так)
    :взяти наступний вид нагадування
    (про сесію або про рекомендацію);
    while (є ще варіант часу нагадування для цього виду?) is (так)
      :взяти наступний варіант часу
      (наприклад, за добу або за годину до сесії);
      :знайти кандидатів на нагадування
      для цього виду й варіанта;
      while (є ще необроблений кандидат?) is (так)
        :додати запис до черги нагадувань у базі даних;
      endwhile (ні)
    endwhile (ні)
  endwhile (ні)
  stop
  @enduml
