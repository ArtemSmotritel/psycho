@startuml
' Підрозділ 3.2 — Структурна схема реалізації (PSM), варіант із вузлами розгортання.
' Уточнює діаграму компонентів (додаток Г) технологіями реалізації з підрозділу 3.1
' та відображає цільову платформу: підсистеми загорнуто у вузли розгортання,
' позначено обмеження розгортання в один екземпляр.

skinparam defaultFontName Arial
skinparam shadowing false
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam wrapWidth 130
left to right direction
skinparam linetype polyline
skinparam defaultFontSize 12
skinparam nodesep 14
skinparam ranksep 45

actor "Психолог" as psycho
actor "Клієнт" as clientActor

node "Браузер користувача — SPA\n(TypeScript, React 19, React Router v7)" <<device>> {
    component "Автентифікація та вибір ролі\n(Better Auth)" as cAuth
    component "Інтерфейс психолога\n(shadcn/ui, Tailwind)" as cPsyUI
    component "Інтерфейс клієнта\n(shadcn/ui, Tailwind)" as cCliUI
    component "Інтерактивна дошка\n(Excalidraw)" as cBoard
    component "API-клієнт\n(Axios)" as cApi
}

node "Сервер застосунку — один процес Bun\n(HTTP API + WebSocket + cron)\nTypeScript, Bun, Hono" <<singleInstance>> as appServer {
    component "HTTP API\n(Hono, middleware сесії та ролей)" as sHttp
    component "Whiteboard WebSocket-шлюз\n(createBunWebSocket)" as sGateway
    component "Scheduler\n(Bun.cron)" as sCron
    component "Notification Service\n(черга листів)" as sNotif
    component "Better Auth" as sAuth

    component "Users Service" as sUsers
    component "Client Service" as sClients
    component "Invitation Service" as sInvites
    component "Session Service" as sSessions
    component "Whiteboard Service" as sWhiteboard
    component "Session Attachment Service" as sAttach
    component "File Storage Service" as sFiles
    component "Associative Image Service" as sImages
    component "Dashboard Service" as sDash
    component "Progress Service" as sProgress

    component "Репозиторії\n(доступ до даних, SQL-запити)" as sRepo
}

note bottom of appServer
    Розгортання в один екземпляр: внутрішньопроцесний cron
    (такти черги листів) і локальне файлове сховище не
    поділяються між репліками.
end note

database "PostgreSQL\n(зовнішній екземпляр)" <<subsystem>> {
    component "Схема даних\n(користувачі, сесії, вкладення,\nзображення, файли, сповіщення)" <<data>> as dSchema
}

folder "Файлове сховище — локальний диск\n(на хості застосунку)" <<storage>> {
    component "Завантажені файли" <<data>> as fFiles
}

cloud "Зовнішні сервіси" <<subsystem>> {
    component "Google OAuth 2.0" as extOAuth
    component "Google Calendar API\n(googleapis)" as extCalendar
    component "Brevo" as extMail
}

' ---- Канали клієнт–сервер ----
interface "REST / HTTP" as iRest
interface "WebSocket" as iWs
cApi --( iRest
iRest -- sHttp
cBoard --( iWs
iWs -- sGateway

' ---- Актори ----
psycho --> cAuth
psycho --> cPsyUI
clientActor --> cAuth
clientActor --> cCliUI

' ---- Клієнтська частина ----
cPsyUI ..> cBoard
cCliUI ..> cBoard
cAuth ..> cApi
cPsyUI ..> cApi
cCliUI ..> cApi

' ---- Маршрутизація до сервісів ----
sHttp ..> sAuth
sHttp ..> sUsers
sHttp ..> sClients
sHttp ..> sInvites
sHttp ..> sSessions
sHttp ..> sAttach
sHttp ..> sFiles
sHttp ..> sImages
sHttp ..> sDash
sHttp ..> sProgress
sGateway ..> sAuth
sGateway ..> sSessions
sGateway ..> sWhiteboard

sAttach ..> sFiles
sImages ..> sFiles
sSessions .[norank].> sWhiteboard

sCron ..> sNotif
sInvites ..> sNotif
sAttach ..> sNotif

' ---- Доступ до даних ----
' Усі сервіси звертаються до даних через шар репозиторіїв (SQL-запити),
' а не безпосередньо до драйвера БД.
sUsers ..> sRepo
sClients ..> sRepo
sInvites ..> sRepo
sSessions ..> sRepo
sWhiteboard ..> sRepo
sAttach ..> sRepo
sFiles ..> sRepo
sImages ..> sRepo
sDash ..> sRepo
sProgress ..> sRepo
sNotif ..> sRepo

interface "Bun SQL" as iBunSql
iBunSql -- dSchema
sRepo --( iBunSql

' Better Auth веде власний доступ до тієї ж БД через окремий драйвер
interface "node-postgres (pg Pool)" as iPg
iPg -- dSchema
sAuth --( iPg

' ---- Файлове сховище ----
sFiles ..> fFiles

' ---- Зовнішні сервіси (складання «кулька-гніздо», протокол на інтерфейсі) ----
interface "OAuth 2.0 / HTTPS" as iOAuth
interface "REST / HTTPS" as iCalendar
interface "REST / HTTPS" as iMail
extOAuth -- iOAuth
extCalendar -- iCalendar
extMail -- iMail
sAuth --( iOAuth
sSessions --( iCalendar
sNotif --( iMail

@enduml
