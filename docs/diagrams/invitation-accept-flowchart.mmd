%% Блок-схема алгоритму прийняття запрошення (підрозділ 3.3.4), нотація ISO 5807.
%% Відображає InvitationsService.acceptByToken
%% (backend/src/features/invitations/services.ts).
%% Фігури: овал — початок/кінець; паралелограм — ввід/вивід; прямокутник — дія;
%% ромб — умова; прямокутник із подвійними лініями — виклик підпрограм.
%% Літеру додатка узгодити з фінальним порядком додатків.
flowchart TD
    S(["Початок"])
    I[/"Ввід: token, userEmail, userId"/]
    P1["email = trim(lower(userEmail))"]
    F[["Знайти запрошення за token"]]
    D1{"Запрошення не знайдено<br/>або status == accepted?"}
    D2{"invitedEmail != email?"}
    D3{"userId == psychologistId<br/>або userId уже клієнт?"}
    T[["Транзакція: позначити запрошення прийнятим;<br/>створити зв'язок психолог–клієнт"]]
    O1[/"Вивід: відмова"/]
    O2[/"Вивід: psychologistId, clientId"/]
    E(["Кінець"])

    S --> I --> P1 --> F --> D1
    D1 -- Так --> O1 --> E
    D1 -- Ні --> D2
    D2 -- Так --> O1
    D2 -- Ні --> D3
    D3 -- Так --> O1
    D3 -- Ні --> T --> O2 --> E
