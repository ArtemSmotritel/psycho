@startuml
' Локальна діаграма класів пакета «Інтерактивна дошка» (підрозділ 3.3.1).
' Платформозалежний рівень (PSM): відображає реалізацію з
' backend/src/features/whiteboard/{routes,services,repo,models}.ts.
' У коді модулі — заморожені const-обʼєкти та функції; на діаграмі вони
' змодельовані класами (<<module>>), а модульний стан routes.ts
' (rooms, saveTimers) винесено в клас RoomRegistry.
' Розбір повідомлень (parseMessage) і автентифікація (better-auth) показані
' як операції WhiteboardRoutes, щоб не перевантажувати діаграму звʼязками.
' Літеру додатка узгодити з фінальним порядком додатків.

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName "Times New Roman"
hide empty members


class WhiteboardRoutes <<module>> {
    + upgradeWebSocket(appointmentId): WSEvents
    - authenticate(headers): Session | null
    - parseMessage(raw: string): IncomingMessage | null
    - onOpen(): void
    - onMessage(event): void
    - onClose(): void
}

class RoomRegistry <<module>> {
    - rooms: Map<string, Room>
    - saveTimers: Map<string, Timer>
    - SAVE_DEBOUNCE_MS: number = 3000
    + scheduleSave(appointmentId, room): void
    + flushPendingSave(appointmentId, room): void
    + broadcast(room, sender, message): void
}

class Room {
    + connections: Set<RoomConnection>
    + state: WhiteboardState
}

class RoomConnection {
    + ws: ServerWebSocket
    + userId: string
    + userName: string
}

class WhiteboardService <<module>> {
    + loadState(appointmentId): Promise<WhiteboardState>
    + saveState(appointmentId, state): Promise<void>
    + clearState(appointmentId): Promise<void>
}

class WhiteboardRepo <<module>> {
    + findStateByAppointmentId(appointmentId): Promise<WhiteboardState | null>
    + updateState(appointmentId, state, executor): Promise<void>
    + clearState(appointmentId, executor): Promise<void>
}

class WhiteboardState <<interface>> {
    + elements: WhiteboardElement[]
    + files: WhiteboardFiles
}

class AppointmentsService <<module>> {
    + getForParticipant(appointmentId, userId): Promise<Appointment | null>
}

WhiteboardRoutes --> RoomRegistry
WhiteboardRoutes ..> AppointmentsService : перевірка учасника\nта статусу «active»
WhiteboardRoutes ..> WhiteboardService : loadState
RoomRegistry "1" *-- "0..*" Room
Room "1" o-- "1..*" RoomConnection
Room --> WhiteboardState
RoomRegistry ..> WhiteboardService : saveState\n(через 3 с після зміни)
WhiteboardService --> WhiteboardRepo

@enduml
