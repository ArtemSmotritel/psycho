@startuml
!theme plain
skinparam linetype ortho
start

skinparam defaultFontSize 24

repeat :Psychologist submits session form;

if (Is user authenticated as a psychologist?) then (yes)
  :Validate session data;
  if (All validations pass?) then (yes)
    note right
    Validations (in order):
    - valid date format (request schema)
    - end time is after start time
    - client belongs to psychologist
    - no overlapping sessions
    end note

    :Create session record in database
    (without a Meet link);

    if (Google Meet link requested?) then (yes)
      :Attempt to generate Google Meet link;
      if (Meet link generated?) then (yes)
        :Update session record with Meet link
        and calendar event id;
      else (no)
        :Log a warning;
        :Return "Meet link generation failed"
        flag in the response;
        note right
          Session is still created. Frontend shows
          a warning toast: "Appointment created, but
          the Google Meet link could not be generated.
          You can add it manually later."
        end note
      endif
    else (no)
    endif

    :Show toast, close the form dialog,
    refresh the sessions list;
    stop
  else (no)
    :Show validation error to user;
  endif
else (no)
  :Reject the request;
endif

backward :Psychologist corrects the input;
repeat while (Submit another request?) is (yes)
-> no;
stop

@enduml
