@startuml

skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220

actor "Психолог" as P
actor "Клієнт" as C
participant "Застосунок" as A
database "База даних" as DB
participant "Поштовий сервіс" as M

autonumber

P -> A : Додати клієнта (e-mail клієнта)
activate A
A -> DB : Знайти користувача за e-mail
DB --> A : Результат пошуку
'deactivate A

alt клієнт зареєстрований
    A -> A : Перевірити, що клієнт не є психологом\nі ще не в його списку
    A -> DB : Створити зв’язок «психолог–клієнт»
    DB --> A : Зв’язок збережено
    A --> P : Клієнта додано
else клієнт не зареєстрований
    A -> A : Перевірити, що відкладеного запрошення\nдля цього e-mail ще немає
    A -> DB : Зберегти запрошення
    DB --> A : Запрошення збережено
    A ->> M : Надіслати лист із запрошенням
    deactivate A

    M ->> C : Лист із запрошенням

    C -> C : Відкрити посилання,\nзареєструватися через Google

    C -> A : Прийняти запрошення (токен)
    activate A

    A -> A : Перевірити токен і збіг e-mail
    A -> DB : Позначити запрошення прийнятим;\nстворити зв’язок «психолог–клієнт»
    DB --> A : Зв’язок збережено
    A --> C : Запрошення прийнято
    deactivate A
end


@enduml
