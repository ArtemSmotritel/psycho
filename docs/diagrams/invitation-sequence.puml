@startuml

skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220

actor ":__Психолог__" as P
participant ":__Застосунок__" as A
database ":__База даних__" as DB
participant ":__Поштовий сервіс__" as M

autonumber


activate P
P -> A : Додати клієнта (email клієнта)
activate A
A -> DB ++ : Знайти користувача за email
DB --> A -- : Результат пошуку

alt клієнт зареєстрований
    alt email клієнта збігається з email психолога
        A --> P : Не можна додати самого себе
    else email клієнта інший
        A -> DB ++ : Перевірити наявність зв’язку «психолог–клієнт»
        DB --> A -- : Зв’язок є або відсутній

        alt зв’язок уже є
            A --> P : Клієнт уже у вашому списку
        else зв’язку немає
            A -> DB ++ : Створити зв’язок «психолог–клієнт»;\nзакрити запрошення для цієї пошти, якщо воно є
            DB --> A -- : Зв’язок збережено
            A --> P : Клієнта додано
        end
    end
else клієнт не зареєстрований
    A --> P : Акаунта з таким email немає

P -> A : Запросити клієнта (email клієнта)
A -> DB ++ : Знайти користувача за email
DB --> A -- : Результат пошуку

alt email збігається з email психолога
    A --> P : Не можна додати самого себе
else клієнт зареєстрований і вже у списку психолога
    A --> P : Клієнт уже доданий
else інакше
    A -> DB ++ : Знайти неприйняте запрошення\nдля цього email
    DB --> A -- : Запрошення, якщо воно існує

    alt запрошення вже надіслано
        A --> P : Наявне запрошення з посиланням
    else запрошення ще немає
        A -> DB ++ : Створити запрошення
        DB --> A -- : Запрошення збережено
        A ->> M : Надіслати лист із запрошенням
        A --> P : Запрошення надіслано
        deactivate P
        deactivate A
    end
end
end

@enduml
