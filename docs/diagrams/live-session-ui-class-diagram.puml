@startuml
' Діаграма класів React-компонентів живої сесії (підрозділ 3.3.x, інтерфейс).
' Платформозалежний рівень (PSM): відображає реалізацію з
' frontend/app/routes/psychologist/live-session.tsx,
' frontend/app/routes/client/live-appointment.tsx,
' frontend/app/hooks/useWhiteboardSync.ts, frontend/app/components/whiteboard/*.
' Функціональні компоненти React змодельовані класами: пропси та стан —
' атрибути, обробники подій — операції. Хуки показано стереотипом <<hook>>.
' Компоненти бібліотеки shadcn/ui (Sheet, Tabs, Button) та службові
' компоненти (ConfirmAction, Loading) на діаграмі не показано.
' Літеру додатка узгодити з фінальним порядком додатків.

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName "Times New Roman"
hide empty members

package "Спільні для психолога і клієнта" {
    class useWhiteboardSync <<hook>> {
        + remoteCursors: Map<string, Cursor>
        + connected: boolean
        + setExcalidrawAPI(api): void
        + onWhiteboardChange(elements, appState, files): void
        + onPointerUpdate(payload): void
    }

    class WhiteboardCursorOverlay <<component>> {
        + remoteCursors: Map<string, Cursor>
        + excalidrawAPI: ExcalidrawImperativeAPI
    }
СИСТЕМИ
    class Excalidraw <<third-party>> {
        + excalidrawAPI: callback
        + onChange: callback
        + onPointerUpdate: callback
    }
}

package "Інтерфейс психолога" {
    class LiveSession <<page>> {
        - time: string
        - isEnding: boolean
        - followUpAppointment: Appointment | null
        - handleEndAppointment(): void
        - handleFollowUpClose(): void
    }

    class WhiteboardImageInsert <<component>> {
        + excalidrawAPI: ExcalidrawImperativeAPI
        + insertImageOntoCanvas(image, api): void
    }

    class AppointmentNotesPanel <<component>> {
        + clientId: string
        + appointmentId: string
    }

    class AppointmentRecommendationsPanel <<component>> {
        + clientId: string
        + appointmentId: string
    }

    class PostSessionFollowUpDialog <<component>> {
        + endedAppointment: Appointment
        + open: boolean
        + onClose(): void
    }
}

package "Інтерфейс клієнта" {
    class LiveAppointment <<page>> {
        - appointment: AppointmentWithPsycho
        - impressions: Attachment[]
        - showEndedModal: boolean
        - handleCreateImpression(values): void
    }

    class AttachmentForm <<component>> {
        + type: "impression"
        + onSubmit(values): void
    }

    class AttachmentList <<component>> {
        + items: Attachment[]
        + isLoading: boolean
    }

    class PostSessionImpressionDialog <<component>> {
        + open: boolean
        + appointmentId: string
        + onSubmitted(): void
        + onSkip(): void
    }
}

class "Whiteboard WebSocket-шлюз" as Gateway <<backend>>

LiveSession ..> useWhiteboardSync
LiveAppointment ..> useWhiteboardSync
useWhiteboardSync ..> Gateway : WebSocket

LiveSession *-- Excalidraw
LiveSession *-- WhiteboardCursorOverlay
LiveAppointment *-- Excalidraw
LiveAppointment *-- WhiteboardCursorOverlay

LiveSession *-- WhiteboardImageInsert
LiveSession *-- AppointmentNotesPanel
LiveSession *-- AppointmentRecommendationsPanel
LiveSession *-- PostSessionFollowUpDialog

LiveAppointment *-- AttachmentForm
LiveAppointment *-- AttachmentList
LiveAppointment *-- PostSessionImpressionDialog

note bottom of useWhiteboardSync
  Хук зберігає WebSocket-з'єднання та передає зміни
  сцени між Excalidraw і сервером. Зміни, отримані
  від сервера, не надсилаються назад: їх відсікає
  порівняння підпису елементів id@version.
end note
@enduml
