@startuml whiteboard-1-connection
title 1. Connection & State Restore

actor User
participant "React Component" as Comp
participant "useWhiteboardSync" as Hook
participant "Excalidraw" as Exc
participant "WebSocket" as WS
participant "Backend WS" as Server
database PostgreSQL as DB

User -> Comp : Opens live session page
Comp -> Hook : useWhiteboardSync(appointmentId)
Hook -> WS : new WebSocket(wsUrl)
WS -> Server : HTTP Upgrade + cookie

Server -> Server : getSession(headers)
Server -> Server : findAppointmentByIdForParticipant()
alt Auth fails or appointment not active
    Server -> WS : ws.close(1008)
end

Server -> WS : Connection accepted
WS -> Hook : onopen → setConnected(true)

== Room Init ==

alt Room not in memory
    Server -> DB : SELECT whiteboard_elements,\nwhiteboard_files
    DB --> Server : JSONB (parse if string)
    Server -> Server : rooms.set(appointmentId, { ... })
end
Server -> Server : room.connections.add(conn)
Server -> WS : { type: "scene_init", elements, files }

WS -> Hook : onmessage

alt Excalidraw API ready
    Hook -> Exc : updateScene() + addFiles()
    Hook -> Hook : lastRemoteSignatureRef = sig
else API not ready (lazy-loaded)
    Hook -> Hook : pendingSceneRef = { elements, files }
    ... Excalidraw loads ...
    Exc -> Hook : setExcalidrawAPI(api)
    Hook -> Exc : updateScene() + addFiles()
    Hook -> Hook : pendingSceneRef = null
end

@enduml


@startuml whiteboard-2-element-sync
title 2. Element & File Sync

actor "User A" as UA
participant "Excalidraw A" as ExcA
participant "Hook A" as HA
participant "WS A" as WsA
participant "Backend" as Server
database PostgreSQL as DB
participant "WS B" as WsB
participant "Hook B" as HB
participant "Excalidraw B" as ExcB

== Element Sync ==

UA -> ExcA : Draws on canvas
ExcA -> HA : onChange(elements, appState, files)
HA -> HA : sig = elementSignature(elements)\nsig !== lastRemoteSignatureRef → send
HA -> WsA : { type: "elements", elements }

WsA -> Server : onMessage
Server -> Server : room.lastElements = elements
Server -> Server : Reset 3s debounce timer
Server -> WsB : Broadcast to others

WsB -> HB : onmessage
HB -> HB : lastRemoteSignatureRef = sig
HB -> ExcB : updateScene({ elements })

note over HB, ExcB
  Excalidraw fires onChange after updateScene.
  sig === lastRemoteSignatureRef → suppressed.
  No echo loop.
end note

== File Sync ==

UA -> ExcA : Adds image
ExcA -> HA : onChange(elements, appState, files)
HA -> HA : Filter via sentFilesRef → newFiles
HA -> WsA : { type: "files", files: newFiles }

WsA -> Server : onMessage
Server -> Server : room.lastFiles merge
Server -> Server : Reset 3s debounce timer
Server -> WsB : Broadcast

WsB -> HB : onmessage
HB -> ExcB : addFiles(files)
HB -> HB : sentFilesRef.add(fileIds)

== Debounced DB Save ==

note over Server, DB
  3s after last elements/files message:
end note
Server -> DB : UPDATE appointments\nSET whiteboard_elements, whiteboard_files

@enduml


@startuml whiteboard-3-cursor-sync
title 3. Cursor Sync

actor "User A" as UA
participant "Excalidraw A" as ExcA
participant "Hook A" as HA
participant "WS A" as WsA
participant "Backend" as Server
participant "WS B" as WsB
participant "Hook B" as HB
participant "CursorOverlay B" as Overlay

UA -> ExcA : Moves pointer
ExcA -> HA : onPointerUpdate({ pointer: {x, y} })
HA -> WsA : { type: "cursor", x, y }

WsA -> Server : onMessage
Server -> Server : Attach userId
Server -> WsB : { type: "cursor", x, y, userId }

WsB -> HB : onmessage
HB -> HB : setRemoteCursors(\n  Map.set(userId, {x, y}))
HB -> Overlay : remoteCursors prop
Overlay -> Overlay : scene→screen transform:\nscreenX = (x + scrollX) * zoom\nRender colored dot

@enduml


@startuml whiteboard-4-disconnect-end
title 4. Disconnect & End Appointment

actor "User A\n(Psychologist)" as UA
participant "Component A" as CompA
participant "Hook A" as HA
participant "WS A" as WsA
participant "Backend" as Server
database PostgreSQL as DB
participant "Component B\n(Client)" as CompB

== Disconnect ==

UA -> CompA : Navigate away / refresh
CompA -> HA : useEffect cleanup
HA -> WsA : ws.close()
WsA -> Server : onClose

Server -> Server : room.connections.delete(conn)

alt Last connection in room
    alt Pending debounce timer
        Server -> Server : clearTimeout(timer)
        Server -> DB : saveWhiteboardState()\nimmediate flush
    end
    Server -> Server : rooms.delete(appointmentId)
end

== End Appointment ==

UA -> CompA : Click "End Appointment"
CompA -> CompA : exportToBlob() → PNG snapshot
CompA -> Server : POST /api/.../end\n{ snapshotDataUrl }
Server -> DB : UPDATE status='past',\nendedAt, whiteboard_snapshot

note over CompB
  Client polls every 5s →
  detects status='past' →
  "Session Ended" modal →
  auto-redirect after 5s
end note

@enduml
